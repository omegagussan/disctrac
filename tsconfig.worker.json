{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    /* Worker scope: no DOM globals, but WebGPU and WebCodecs are available. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": ["@webgpu/types", "dom-webcodecs"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* OpenCV.js ships an emscripten CommonJS build whose exports object has a
       `then` method; importing it as a namespace makes the loader treat the
       module itself as a thenable and fail. A default import avoids that. */
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/cv-worker.ts", "src/cv-protocol.ts"]
}
